ninja_required_version = 1.3
cxx = c++
nvcc = /home/zhuangshuxin/miniconda3/envs/3dgs/bin/nvcc

cflags = -pthread -B /home/zhuangshuxin/miniconda3/envs/3dgs/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/zhuangshuxin/miniconda3/envs/3dgs/include -fPIC -O2 -isystem /home/zhuangshuxin/miniconda3/envs/3dgs/include -fPIC '-DRENDERER_SOURCE_HASH="3c1bbf8051d22bddcb889bbeb041ef8f7bcffa67d220a83748e765b3ef7b25a3"' -I/data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include/TH -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include/THC -I/home/zhuangshuxin/miniconda3/envs/3dgs/include -I/home/zhuangshuxin/miniconda3/envs/3dgs/include/python3.10 -c
post_cflags = -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C_G3D -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = '-DRENDERER_SOURCE_HASH="3c1bbf8051d22bddcb889bbeb041ef8f7bcffa67d220a83748e765b3ef7b25a3"' -I/data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include/TH -I/home/zhuangshuxin/miniconda3/envs/3dgs/lib/python3.10/site-packages/torch/include/THC -I/home/zhuangshuxin/miniconda3/envs/3dgs/include -I/home/zhuangshuxin/miniconda3/envs/3dgs/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -lineinfo -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C_G3D -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/build/temp.linux-x86_64-cpython-310/cuda_rasterizer/backward.o: cuda_compile /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/cuda_rasterizer/backward.cu
