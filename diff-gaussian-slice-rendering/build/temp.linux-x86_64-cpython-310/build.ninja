build /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/build/temp.linux-x86_64-cpython-310/cuda_rasterizer/rasterizer_impl.o: cuda_compile /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/cuda_rasterizer/rasterizer_impl.cu
build /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/build/temp.linux-x86_64-cpython-310/ext.o: compile /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/ext.cpp
build /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/build/temp.linux-x86_64-cpython-310/rasterize_points.o: cuda_compile /data1/zhuangshuxin/Codes/C3DGS/diff-gaussian-slice-rendering/rasterize_points.cu






